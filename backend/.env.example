# Copy to backend/.env only when overriding these local defaults.
# Keep passwords, API keys, and tokens out of this file and version control.
AEGIS_MONITOR_CHECK_WORKERS=32
AEGIS_BACKUP_ENABLED=true
AEGIS_BACKUP_INTERVAL_HOURS=24
AEGIS_BACKUP_KEEP_COUNT=14
AEGIS_BACKUP_DIRECTORY=./backups
AEGIS_REPORT_DIRECTORY=./reports
AEGIS_ATTACHMENT_DIRECTORY=./attachments
AEGIS_HISTORY_RETENTION_DAYS=90
AEGIS_ALLOW_PUBLIC_LAN_DISCOVERY=false
AEGIS_DISCOVERY_PING_WORKERS=64
AEGIS_DISCOVERY_PING_TIMEOUT_SECONDS=0.4
AEGIS_DISCOVERY_MDNS_TIMEOUT_SECONDS=2.0

# Optional integrations. Supply real values through the process environment.
# NVD_API_KEY=
# AEGIS_FOUNDRY_LOCAL_URL=http://127.0.0.1:PORT
# AEGIS_FOUNDRY_LOCAL_MODEL=MODEL_NAME
