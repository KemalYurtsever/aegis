# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
coverage.xml
htmlcov/
.venv/
*.egg-info/

# Local data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backups/
attachments/
logs/
reports/
*.log

# Environment files and credentials. Keep sanitized examples versionable.
.env
.env.*
!.env.example
!.env.*.example

# Secret material
/secrets/*
!/secrets/.gitignore
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
credentials.json
deploy/kubernetes/secret*.yaml
!deploy/kubernetes/secret*.example.yaml

# Frontend dependencies and build artifacts
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak
